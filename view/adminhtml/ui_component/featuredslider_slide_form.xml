<?xml version="1.0" encoding="UTF-8"?>
<form xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Ui:etc/ui_configuration.xsd">
    <argument name="data" xsi:type="array">
        <item name="js_config" xsi:type="array">
            <item name="provider" xsi:type="string">featuredslider_slide_form.featuredslider_slide_form_data_source</item>
        </item>
        <item name="label" xsi:type="string" translate="true">Slide</item>
        <item name="config" xsi:type="array">
            <item name="dataScope" xsi:type="string">data</item>
            <item name="namespace" xsi:type="string">featuredslider_slide_form</item>
        </item>
        <item name="template" xsi:type="string">templates/form/collapsible</item>
    </argument>

    <settings>
        <buttons>
            <button name="back" class="WapplerSystems\FeaturedSlider\Block\Adminhtml\Slide\BackButton"/>
            <button name="delete" class="WapplerSystems\FeaturedSlider\Block\Adminhtml\Slide\DeleteButton"/>
            <button name="save" class="WapplerSystems\FeaturedSlider\Block\Adminhtml\Slide\SaveButton"/>
            <button name="save_and_continue" class="WapplerSystems\FeaturedSlider\Block\Adminhtml\Slide\SaveAndContinueButton"/>
        </buttons>
        <namespace>featuredslider_slide_form</namespace>
        <dataScope>data</dataScope>
        <deps>
            <dep>featuredslider_slide_form.featuredslider_slide_form_data_source</dep>
        </deps>
    </settings>

    <dataSource name="featuredslider_slide_form_data_source">
        <argument name="data" xsi:type="array">
            <item name="js_config" xsi:type="array">
                <item name="component" xsi:type="string">Magento_Ui/js/form/provider</item>
            </item>
        </argument>
        <settings>
            <submitUrl path="*/*/save"/>
        </settings>
        <dataProvider class="WapplerSystems\FeaturedSlider\Model\Slide\DataProvider"
                      name="featuredslider_slide_form_data_source">
            <settings>
                <requestFieldName>slide_id</requestFieldName>
                <primaryFieldName>slide_id</primaryFieldName>
            </settings>
        </dataProvider>
    </dataSource>

    <fieldset name="general">
        <settings>
            <label translate="true">General</label>
        </settings>
        <field name="slide_id" formElement="input">
            <settings>
                <dataType>text</dataType>
                <visible>false</visible>
                <dataScope>slide_id</dataScope>
            </settings>
        </field>
        <field name="slider_id" formElement="select" sortOrder="10">
            <settings>
                <dataType>int</dataType>
                <label translate="true">Slider</label>
                <dataScope>slider_id</dataScope>
                <validation>
                    <rule name="required-entry" xsi:type="boolean">true</rule>
                </validation>
            </settings>
            <formElements>
                <select>
                    <settings>
                        <options class="WapplerSystems\FeaturedSlider\Model\Source\Sliders"/>
                    </settings>
                </select>
            </formElements>
        </field>
        <field name="title" formElement="input" sortOrder="20">
            <settings>
                <dataType>text</dataType>
                <label translate="true">Title</label>
                <dataScope>title</dataScope>
                <validation>
                    <rule name="required-entry" xsi:type="boolean">true</rule>
                </validation>
            </settings>
        </field>
        <field name="subtitle" formElement="input" sortOrder="30">
            <settings>
                <dataType>text</dataType>
                <label translate="true">Subtitle</label>
                <dataScope>subtitle</dataScope>
            </settings>
        </field>
        <field name="description" formElement="textarea" sortOrder="40">
            <settings>
                <dataType>text</dataType>
                <label translate="true">Description</label>
                <dataScope>description</dataScope>
            </settings>
        </field>
        <field name="image" formElement="fileUploader" sortOrder="50">
            <settings>
                <label translate="true">Image</label>
                <dataScope>image</dataScope>
                <componentType>fileUploader</componentType>
            </settings>
            <formElements>
                <fileUploader>
                    <settings>
                        <required>false</required>
                        <uploaderConfig>
                            <param xsi:type="string" name="url">featuredslider/slide/upload</param>
                        </uploaderConfig>
                        <previewTmpl>Magento_Catalog/image-preview</previewTmpl>
                        <openDialogTitle translate="true">Slide Image</openDialogTitle>
                        <maxFileSize>4194304</maxFileSize>
                        <allowedExtensions>jpg jpeg gif png webp svg</allowedExtensions>
                    </settings>
                </fileUploader>
            </formElements>
        </field>
        <field name="image_alt" formElement="input" sortOrder="60">
            <settings>
                <dataType>text</dataType>
                <label translate="true">Image Alt Text</label>
                <dataScope>image_alt</dataScope>
            </settings>
        </field>
        <field name="sort_order" formElement="input" sortOrder="70">
            <settings>
                <dataType>number</dataType>
                <label translate="true">Sort Order</label>
                <dataScope>sort_order</dataScope>
            </settings>
        </field>
        <field name="is_active" formElement="checkbox" sortOrder="80">
            <settings>
                <dataType>boolean</dataType>
                <label translate="true">Active</label>
                <dataScope>is_active</dataScope>
            </settings>
            <formElements>
                <checkbox>
                    <settings>
                        <valueMap>
                            <map name="false" xsi:type="number">0</map>
                            <map name="true" xsi:type="number">1</map>
                        </valueMap>
                        <prefer>toggle</prefer>
                    </settings>
                </checkbox>
            </formElements>
        </field>
        <field name="active_from" formElement="date" sortOrder="90">
            <settings>
                <dataType>text</dataType>
                <label translate="true">Active From</label>
                <dataScope>active_from</dataScope>
            </settings>
        </field>
        <field name="active_to" formElement="date" sortOrder="100">
            <settings>
                <dataType>text</dataType>
                <label translate="true">Active To</label>
                <dataScope>active_to</dataScope>
            </settings>
        </field>
    </fieldset>

    <fieldset name="link">
        <settings>
            <label translate="true">Link Target</label>
            <collapsible>true</collapsible>
        </settings>

        <field name="content_type" formElement="select" sortOrder="10">
            <settings>
                <dataType>text</dataType>
                <label translate="true">Content Type</label>
                <dataScope>content_type</dataScope>
                <switcherConfig>
                    <rules>
                        <rule name="0">
                            <value>url</value>
                            <actions>
                                <action name="0">
                                    <target>${ $.parentName }.link_url</target>
                                    <callback>show</callback>
                                </action>
                                <action name="1">
                                    <target>${ $.parentName }.link_product_id</target>
                                    <callback>hide</callback>
                                </action>
                                <action name="2">
                                    <target>${ $.parentName }.link_category_id</target>
                                    <callback>hide</callback>
                                </action>
                                <action name="3">
                                    <target>${ $.parentName }.link_cms_page_id</target>
                                    <callback>hide</callback>
                                </action>
                            </actions>
                        </rule>
                        <rule name="1">
                            <value>product</value>
                            <actions>
                                <action name="0">
                                    <target>${ $.parentName }.link_url</target>
                                    <callback>hide</callback>
                                </action>
                                <action name="1">
                                    <target>${ $.parentName }.link_product_id</target>
                                    <callback>show</callback>
                                </action>
                                <action name="2">
                                    <target>${ $.parentName }.link_category_id</target>
                                    <callback>hide</callback>
                                </action>
                                <action name="3">
                                    <target>${ $.parentName }.link_cms_page_id</target>
                                    <callback>hide</callback>
                                </action>
                            </actions>
                        </rule>
                        <rule name="2">
                            <value>category</value>
                            <actions>
                                <action name="0">
                                    <target>${ $.parentName }.link_url</target>
                                    <callback>hide</callback>
                                </action>
                                <action name="1">
                                    <target>${ $.parentName }.link_product_id</target>
                                    <callback>hide</callback>
                                </action>
                                <action name="2">
                                    <target>${ $.parentName }.link_category_id</target>
                                    <callback>show</callback>
                                </action>
                                <action name="3">
                                    <target>${ $.parentName }.link_cms_page_id</target>
                                    <callback>hide</callback>
                                </action>
                            </actions>
                        </rule>
                        <rule name="3">
                            <value>cms_page</value>
                            <actions>
                                <action name="0">
                                    <target>${ $.parentName }.link_url</target>
                                    <callback>hide</callback>
                                </action>
                                <action name="1">
                                    <target>${ $.parentName }.link_product_id</target>
                                    <callback>hide</callback>
                                </action>
                                <action name="2">
                                    <target>${ $.parentName }.link_category_id</target>
                                    <callback>hide</callback>
                                </action>
                                <action name="3">
                                    <target>${ $.parentName }.link_cms_page_id</target>
                                    <callback>show</callback>
                                </action>
                            </actions>
                        </rule>
                    </rules>
                    <enabled>true</enabled>
                </switcherConfig>
            </settings>
            <formElements>
                <select>
                    <settings>
                        <options class="WapplerSystems\FeaturedSlider\Model\Source\ContentType"/>
                    </settings>
                </select>
            </formElements>
        </field>

        <field name="link_url" formElement="input" sortOrder="20">
            <settings>
                <dataType>text</dataType>
                <label translate="true">Custom URL</label>
                <notice translate="true">Absolute or relative (e.g. /sale.html or https://...).</notice>
                <dataScope>link_url</dataScope>
            </settings>
        </field>

        <field name="link_product_id" component="WapplerSystems_FeaturedSlider/js/form/element/product-autocomplete" sortOrder="30">
            <settings>
                <dataType>number</dataType>
                <label translate="true">Product</label>
                <dataScope>link_product_id</dataScope>
                <notice translate="true">Search by name or SKU.</notice>
            </settings>
        </field>

        <field name="link_category_id" formElement="select" sortOrder="40">
            <settings>
                <dataType>int</dataType>
                <label translate="true">Category</label>
                <dataScope>link_category_id</dataScope>
            </settings>
            <formElements>
                <select>
                    <settings>
                        <options class="WapplerSystems\FeaturedSlider\Model\Source\Categories"/>
                    </settings>
                </select>
            </formElements>
        </field>

        <field name="link_cms_page_id" formElement="select" sortOrder="50">
            <settings>
                <dataType>int</dataType>
                <label translate="true">CMS Page</label>
                <dataScope>link_cms_page_id</dataScope>
            </settings>
            <formElements>
                <select>
                    <settings>
                        <options class="WapplerSystems\FeaturedSlider\Model\Source\CmsPages"/>
                    </settings>
                </select>
            </formElements>
        </field>

        <field name="link_target" formElement="select" sortOrder="60">
            <settings>
                <dataType>text</dataType>
                <label translate="true">Open Link In</label>
                <dataScope>link_target</dataScope>
            </settings>
            <formElements>
                <select>
                    <settings>
                        <options>
                            <option name="self" xsi:type="array">
                                <item name="value" xsi:type="string">_self</item>
                                <item name="label" xsi:type="string" translate="true">Same Window</item>
                            </option>
                            <option name="blank" xsi:type="array">
                                <item name="value" xsi:type="string">_blank</item>
                                <item name="label" xsi:type="string" translate="true">New Window</item>
                            </option>
                        </options>
                    </settings>
                </select>
            </formElements>
        </field>
    </fieldset>
</form>
